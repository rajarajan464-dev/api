<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="3dp"
    android:paddingRight="6dp"
    android:paddingBottom="3dp">

    <!-- Row 1: Header / Tamil Month, Day & Weekday (Top Centered) -->
    <TextView
        android:id="@+id/tv_widget_tamil_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#E6000000"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="3"
        android:text="ஸ்ரீ திருக்கணித பஞ்சாங்கம்"
        android:textColor="#FFE082"
        android:textSize="14.5sp"
        android:textStyle="bold" />

    <!-- Subtle Translucent Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="#33FFFFFF" />

    <!-- Row 2: Nakshatra & Tithi (Side by side, centered) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Nakshatra Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#E6000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="நட்சத்திரம்:"
                android:textColor="#CFD8DC"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_nakshatra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#E6000000"
                android:shadowDx="1.5"
                android:shadowDy="1.5"
                android:shadowRadius="3"
                android:text="அசுவினி (பாதம் 1)"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tithi Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:shadowColor="#E6000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="திதி:"
                android:textColor="#CFD8DC"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_widget_tithi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#E6000000"
                android:shadowDx="1.5"
                android:shadowDy="1.5"
                android:shadowRadius="3"
                android:text="சுக்ல பிரதமை"
                android:textColor="#FFE082"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Current Horai -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:shadowColor="#E6000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="நடப்பு ஓரை: "
            android:textColor="#FFCC80"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_current_hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#E6000000"
            android:shadowDx="1.5"
            android:shadowDy="1.5"
            android:shadowRadius="3"
            android:text="குரு ஓரை"
            android:textColor="#A5D6A7"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 4: Active Time Alert Banner (Rahu/Yamakandam/Kuligai/Nalla Neram - Visible ONLY when active) -->
    <LinearLayout
        android:id="@+id/layout_widget_active_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_tag_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_widget_active_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#E6000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="⚠️ ராகு காலம் நடக்கிறது"
            android:textColor="#FF8A80"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_active_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#E6000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="01:30 PM - 03:00 PM"
            android:textColor="#FFCDD2"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Fallback / Upcoming time notice (Centered) -->
    <TextView
        android:id="@+id/tv_widget_upcoming_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textAlignment="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#E6000000"
        android:shadowDx="1.5"
        android:shadowDy="1.5"
        android:shadowRadius="2"
        android:text="அடுத்த நல்ல நேரம்: 04:30 PM - 06:00 PM"
        android:textColor="#E0E0E0"
        android:textSize="10.5sp" />

</LinearLayout>
